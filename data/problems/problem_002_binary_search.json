{
    "id": "problem_002",
    "category": "algorithms",
    "difficulty": "easy",
    "title": "Binary Search",
    "question": "Given a sorted array and a target, return the index of the target or -1 if it is absent.",
    "constraints": [
        "The input array is sorted in ascending order.",
        "Use logarithmic search time."
    ],
    "function_name": "binary_search",
    "validator": "exact",
    "starter_code": "def binary_search(values, target):\n    low, high = 0, len(values) - 1\n    while low <= high:\n        middle = (low + high) // 2\n        if values[middle] == target:\n            return middle\n        if values[middle] < target:\n            low = middle + 1\n        else:\n            high = middle - 1\n    return -1",
    "reasoning_rubric": {
        "criteria": [
            {
                "name": "Binary-search strategy",
                "concepts": ["binary_search", "sorted_input"],
                "maximum": 60
            },
            {
                "name": "Logarithmic complexity",
                "concepts": ["logarithmic_time"],
                "maximum": 40
            }
        ]
    },
    "validation_cases": [
        {
            "case_id": "first",
            "args": [[1, 3, 5, 7, 9], 1],
            "expected": 0
        },
        {
            "case_id": "middle",
            "args": [[1, 3, 5, 7, 9], 5],
            "expected": 2
        },
        {
            "case_id": "last",
            "args": [[1, 3, 5, 7, 9], 9],
            "expected": 4
        },
        {
            "case_id": "missing",
            "args": [[1, 3, 5, 7, 9], 2],
            "expected": -1
        },
        {
            "case_id": "empty",
            "args": [[], 4],
            "expected": -1
        }
    ]
}
