    "title": "Two Sum",
    "question": "Given an array of integers and a target value, return the indices of two distinct elements whose sum equals the target. Explain the algorithm and its time complexity.",
    "constraints": [
        "The same element cannot be used twice.",
        "The solution should run in O(n) average time.",
        "Return the indices of a valid pair."
    ],
    "expected_concepts": [
        "hash_map",
        "single_pass",
        "O(n)_average_time"
    ],
    "function_name": "two_sum",
    "validator": "two_sum",
    "starter_code": "def two_sum(values, target):\n    seen = {}\n    for index, value in enumerate(values):\n        complement = target - value\n        if complement in seen:\n            return [seen[complement], index]\n        seen[value] = index\n    return None",
